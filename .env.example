# Copiar a .env y completar. El .env no se versiona.
# URL publica final (en produccion https://...): es lo que queda grabado en cada QR
BASE_URL=http://localhost:8000
PUERTO=8000
# Contraseña del panel de admin (no se pide usuario). Sin ella nadie puede entrar.
ADMIN_PASSWORD=cambiar
SECRET_KEY=cadena-larga-y-al-azar
DB_URL=sqlite:///data/boda.db
# Solo PC de la empresa (Docker + Cloudflare Tunnel): token del tunel, ver README
CLOUDFLARE_TUNNEL_TOKEN=
